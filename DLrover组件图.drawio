        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n\nclass Error{\n}\n\nclass ProcessError extends Error{\n}\n\nclass ManualAbort {\n}\n\nProcessError &lt;|-- ManualAbort\n\nclass ContainerError extends Error{\n}\n\nclass PodEvicted {\n}\n\nContainerError &lt;|-- PodEvicted\n\nclass NodeError extends Error{\n}\n\nclass GPUError  {\n}\n\nclass NodeDetectionFailure {\n}\n\nNodeError &lt;|-- GPUError\nNodeError &lt;|-- NodeDetectionFailure\n\nclass JobError extends Error{\n}\n\nclass ResourceError {\n}\n\nclass UserCodeError {\n}\n\nJobError &lt;|-- ResourceError \nJobError &lt;|-- UserCodeError\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="uWAoqgx8xY9bLC8lrcLc-6">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-760" y="-740" width="918" height="278" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n&#39;=== 字体全局设置 ===\nskinparam defaultFontName \&quot;思源黑体\&quot;  &#39;中文字体优先\nskinparam defaultFontName \&quot;Roboto\&quot;   &#39;英文字体备用\nskinparam defaultFontSize 14\nskinparam defaultFontColor #2D2D2D\n\n&#39;=== 元素级微调 ===\nskinparam classFontName \&quot;Microsoft YaHei\&quot;\nskinparam noteFontSize 12\nskinparam sequenceMessageAlign center  &#39;文本居中对齐\n\nstart\n:采集单步迭代时间;\nif (短期窗口波动是否超过阈值α?) then (是)\n    :跳过长期窗口更新;\n    if (降速比是否超过阈值β?) then (是)\n        if (连续降速次数是否超过threshold?) then (是)\n            :累计训练降速总耗时;\n        else (否)\n            :增加连续降速计数;\n        endif\n    else (否)\n        :继续下一次迭代;\n    endif\nelse (否)\n    :更新长期窗口和平均迭代时间;\nendif\nstop\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="mJcnv9RB6uUCWiuuFbvc-2">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-637" y="-310" width="795" height="439" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml 主动检测改进流程\nstart\n:故障主动检测定位组件;\n:训练环境预检测任务;\nif (检测到故障?) then (是)\n  :阻止任务启动并告警;\nelse (否)\n  :启动训练任务;\n  :监控组件上报训练中断;\n  fork\n    :关键故障日志检测任务;\n  fork again\n    :故障节点检测任务;\n  end fork\n  if (检测到故障类型?) then (是)\n    :触发分级容错自愈机制;\n  else (否)\n    :停止任务并告警;\n  endif\nendif\nstop\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="mJcnv9RB6uUCWiuuFbvc-3">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="230" y="-690" width="480" height="580" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nstart\n:训练降速;\n:措施一：算法持续计算累积降速影响;\nif (累积降速是否达到阈值?) then (是)\n  :措施二：训练性能分析;\n  if (累积降速是否达到阈值?) then (是)\n    :措施三:隔离慢节点触发中断型容错;\n  else (否)\n  endif\nelse (否)\n  :措施一：算法持续计算累积降速影响;\nendif\nstop\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="mJcnv9RB6uUCWiuuFbvc-4">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="90" y="-690" width="482" height="450" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n\nstart\n\n:训练故障;\n:主进程持久化检查点;\n\nif (内存检查点?) then (否)\n    :从磁盘加载检查点;\nelse (是)\n    :热加载内存检查点;\nendif\n\n:重启训练进程断点续训;\n\nstop\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="mJcnv9RB6uUCWiuuFbvc-5">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="730" y="-520" width="354.96" height="463.78" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nstart\n:训练进程中断;\nif (节点心跳存在) then (是)\n  :多次尝试重启进程;\n  if (成功?) then (是)\n    :继续训练;\n\n  else (否)\n    :判断节点故障;\n\n  endif\nelse (否)\n  :处理节点宕机;\n \nendif\n   stop\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="mJcnv9RB6uUCWiuuFbvc-7">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
