        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml 被动监控流程\nstart\n:训练监控组件;\n:上报监控指标、节点心跳;\nif (训练进程中断?) then (是)\n  :尝试重启训练进程;\nelse (否)\n  :继续常规监控;\nendif\nstop\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="Mx1gV6xTiy6_RN89OCZ0-2">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=0;image=data:image/svg+xml,;fontFamily=Verdana;" parent="1" vertex="1">
            <mxGeometry x="-80" y="-1530" width="250" height="305" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml 主动检测改进流程\nstart\n:故障主动检测定位组件;\n:训练环境预检测任务;\nif (检测到故障?) then (是)\n  :阻止任务启动并告警;\nelse (否)\n  :监控组件上报训练中断;\n  fork\n    :关键故障日志检测任务;\n  fork again\n    :故障节点检测任务;\n  end fork\n  if (检测到故障类型?) then (是)\n    :触发分级容错自愈机制;\n  else (否)\n    :停止任务并告警;\n  endif\nendif\nstop\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="Mx1gV6xTiy6_RN89OCZ0-6">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="261.56" y="-1685" width="480" height="525" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="Mx1gV6xTiy6_RN89OCZ0-7" value="训练监控组件" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;" parent="1" vertex="1">
